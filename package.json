{
  "name": "saas-agendamento",
  "version": "1.0.0",
  "description": "Sistema SaaS de agendamento",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:integration": "jest tests/integration",
    "build": "tsc",
    "audit": "npm audit --audit-level=high",
    "docker:build": "docker build -t saas-agendamento ."
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
